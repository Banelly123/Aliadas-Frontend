<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aliadas" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/red_error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="chipStyle">@style/AliadadChipStyle</item>
        <item name="alertDialogTheme">@style/AliadasAlertDialogTheme</item>
        <item name="materialButtonStyle">@style/AliadasButtonStyle</item>
    </style>

    <style name="AliadasAlertDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="buttonBarPositiveButtonStyle">@style/AliadasDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AliadasDialogButtonStyle</item>
    </style>

    <style name="AliadasDialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/purple_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AliadadChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/purple_light</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/purple_dark</item>
        <item name="checkedIconTint">@color/purple_primary</item>
    </style>

    <style name="AliadasButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Color selector for nav icons -->
    <style name="NavIconTint">
        <item name="android:state_checked">@color/purple_primary</item>
        <item name="android:state_selected">@color/purple_primary</item>
        <item name="android:state_enabled">@color/text_secondary</item>
    </style>
</resources>
